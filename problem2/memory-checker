#!/bin/bash

# Membaca total memori dan memori terpakai
read -r total
read -r used

# Menghitung sisa memori dan persentase penggunaan
free=$(( total - used ))
usage=$(( used * 100 / total ))

# Menentukan status indikator
if (( usage < 70 )); then
    status="Normal"
elif (( usage >= 70 && usage <= 90 )); then
    status="Warning"
else
    status="Critical"
fi

# Cetak laporan sesuai format
echo "Free: ${free} MB"
echo "Usage: ${usage}%"
echo "Status: ${status}"
