#!/bin/env bash

# Membaca nama depan dan nama belakang dari stdin
read -r first_name last_name

# Mengubah nama belakang menjadi HURUF KAPITAL SEMUA
last_upper=${last_name^^}

# Mengubah nama depan menjadi Title Case
first_lower=${first_name,,}
first_cap=${first_lower^}

# Cetak hasil sesuai format
echo "${last_upper}, ${first_cap}"
