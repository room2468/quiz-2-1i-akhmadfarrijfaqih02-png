#!/bin/bash

total=0
highest_user=""
highest_size=-1
users_over_1000=0

# Membaca data penggunaan disk pengguna dari stdin
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    
    read -r username size <<< "$line"
    (( total += size ))
    
    if (( size > highest_size )); then
        highest_size=$size
        highest_user=$username
    fi
    
    if (( size > 1000 )); then
        (( users_over_1000++ ))
    fi
done

# Cetak laporan akhir
echo "Total usage: $total MB"
echo "Highest user: $highest_user ($highest_size MB)"
echo "Users over 1000 MB: $users_over_1000"
