#!/bin/bash

scripts=0
logs=0
configs=0
others=0

# Membaca daftar nama file baris demi baris dari stdin
while IFS= read -r filename; do
    [[ -z "$filename" ]] && continue
    
    case "$filename" in
        *.sh)   (( scripts++ )) ;;
        *.log)  (( logs++ )) ;;
        *.conf) (( configs++ )) ;;
        *)      (( others++ )) ;;
    esac
done

# Cetak hasil klasifikasi file
echo "Scripts (.sh): $scripts"
echo "Logs (.log): $logs"
echo "Configs (.conf): $configs"
echo "Others: $others"
