#!/bin/bash

scripts=0
logs=0
configs=0
others=0

# Membaca baris demi baris secara utuh (termasuk spasi)
while IFS= read -r filename || [[ -n "$filename" ]]; do
    # Abaikan jika baris benar-benar kosong
    [[ -z "$filename" ]] && continue
    
    # Hapus spasi di awal dan di akhir string untuk akurasi pencocokan
    filename=$(echo "$filename" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    
    case "$filename" in
        *.sh)   (( scripts++ )) ;;
        *.log)  (( logs++ )) ;;
        *.conf) (( configs++ )) ;;
        *)      (( others++ )) ;;
    esac
done

echo "Scripts (.sh): $scripts"
echo "Logs (.log): $logs"
echo "Configs (.conf): $configs"
echo "Others: $others"
